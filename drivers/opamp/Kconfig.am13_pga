config OPAMP_AM13_PGA
	bool "TI AM13 PGA driver"
	default y
	select PINCTRL
	depends on DT_HAS_TI_AM13_PGA_ENABLED
	help
	  Enable driver for the TI AM13E230x/232x Programmable Gain Amplifier
	  (PGA). Provides opamp_set_gain() for runtime gain changes (x1 to x64).
	  Mux topology, filter resistor, and output routing are configured
	  statically via devicetree properties.
